{
  "name": "BookCoverArchive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "predev": "npm run typegen && node ./prebuild.js",
    "dev": "next dev",
    "prebuild": "npm run typegen && node ./prebuild.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typegen": "sanity schema extract --enforce-required-fields --path=src/sanity/extract.json && sanity typegen generate",
    "update-sanity": "pnpm update @sanity/client @sanity/vision @sanity/image-url @portabletext/block-tools @portabletext/react sanity sanity-plugin-link-field next-sanity --latest"
  },
  "dependencies": {
    "@linaria/core": "^6.3.0",
    "@linaria/react": "^6.3.0",
    "@portabletext/block-tools": "^3.5.10",
    "@portabletext/react": "^4.0.3",
    "@sanity/client": "^7.12.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/schema": "^4.10.3",
    "@sanity/ui": "^3.1.10",
    "@sanity/vision": "^4.10.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.3",
    "lodash-es": "^4.17.21",
    "next": "15.5.5",
    "next-sanity": "^11.5.1",
    "next-with-linaria": "^1.2.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.0",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "rss": "^1.2.2",
    "sanity": "^4.10.3",
    "sanity-advanced-validators": "^0.5.3",
    "sanity-plugin-media": "^4.0.0",
    "sass": "^1.93.2",
    "slugify": "^1.6.6",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.7.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/rss": "^0.0.32",
    "groq": "^4.10.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.4",
  "pnpm": {
    "pnpm": {
      "peerDependencyRules": {
        "allowAny": [
          "react",
          "react-dom"
        ]
      }
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
