{
  "name": "BookCoverArchive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typegen": "sanity schema extract --enforce-required-fields --path=src/sanity/extract.json && sanity typegen generate",
    "update-sanity": "pnpm update @sanity/client @sanity/vision @sanity/image-url @portabletext/block-tools @portabletext/react sanity sanity-plugin-link-field next-sanity --latest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:import-sanity": "tsx scripts/import-sanity.ts",
    "db:download-covers": "tsx scripts/download-covers.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@linaria/core": "^6.3.0",
    "@linaria/react": "^6.3.0",
    "@portabletext/block-tools": "^4.1.7",
    "@portabletext/react": "^5.0.0",
    "@prisma/client": "^6.19.3",
    "@sanity/client": "^7.13.1",
    "@sanity/image-url": "^2.0.2",
    "@sanity/schema": "^4.10.3",
    "@sanity/ui": "^3.1.10",
    "@sanity/vision": "^4.20.3",
    "@vercel/blob": "^2.8.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "lodash-es": "^4.17.21",
    "next": "15.5.7",
    "next-sanity": "^11.6.10",
    "next-with-linaria": "^1.2.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.0",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "rss": "^1.2.2",
    "sanity": "^4.20.3",
    "sanity-advanced-validators": "^0.5.3",
    "sanity-plugin-media": "^4.0.0",
    "sanity-plugin-nextjs-do-deploy": "^0.2.3",
    "sass": "^1.93.2",
    "slugify": "^1.6.6",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.7.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/rss": "^0.0.32",
    "dotenv": "^17.2.3",
    "groq": "^4.10.3",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.4",
  "pnpm": {
    "pnpm": {
      "peerDependencyRules": {
        "allowAny": [
          "react",
          "react-dom"
        ]
      }
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
